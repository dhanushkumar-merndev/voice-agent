# Voice backend (Rust). Server-side only; never exposed to the browser.
VOICE_API_URL=http://127.0.0.1:8080
# The backend's API_KEY. Or leave it empty and set VOICE_BACKEND_ENV to an env
# file holding API_KEY (dev defaults to ../voice-backend/.env).
VOICE_API_KEY=
VOICE_BACKEND_ENV=

# Dashboard sign-in. Required in production; without it, dev is open.
DASHBOARD_PASSWORD=
# Signs session cookies (any long random string; defaults to one derived from the password).
SESSION_SECRET=
# Set to 1 only when serving production over plain http (e.g. a LAN box).
INSECURE_COOKIES=

# Copy to .env (in this folder) and fill in. Both voice-backend and voice-frontend
# read it. Moving to the VPS only changes values here.

# --- App ---------------------------------------------------------------------
APP_ENV=local                      # local | production
BIND_ADDR=0.0.0.0:8080
PUBLIC_BASE_URL=https://<your-tunnel-or-domain>   # scripts/dev_tunnel.sh prints one
API_KEY=change-me                  # production: >= 16 chars
LOG_FORMAT=pretty                  # json (default) | pretty
# RUST_LOG=info,server=debug
# VPS only: also start voice-server from docker compose
# COMPOSE_PROFILES=app

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgres://voice:voice@localhost:5432/voice
DATABASE_MAX_CONNECTIONS=20

# --- Object storage (MinIO locally; Tigris or AWS S3 on the VPS) -------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=voice
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_REGION=ap-south-1
S3_FORCE_PATH_STYLE=true

# --- Plivo -------------------------------------------------------------------
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=

# --- Providers ----------------------------------------------------------------
PROVIDER_MODE=sarvam               # sarvam | fake (fake = offline pipeline testing, local only)

# --- Sarvam (one key for STT, TTS and LLM) -----------------------------------
SARVAM_API_KEY=
# saaras:v4 on the realtime socket: more accurate than saaras:v3-realtime, same price.
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_CODEC=wav               # wav (8 kHz, encoded to mu-law locally) | mulaw
# SARVAM_STT_URL=wss://api.sarvam.ai/speech-to-text-realtime/ws
# SARVAM_TTS_URL=wss://api.sarvam.ai/text-to-speech/ws

# --- LLM (Sarvam OpenAI-compatible API) --------------------------------------
LLM_BASE_URL=https://api.sarvam.ai/v1
LLM_MODEL=sarvam-105b-conversations
LLM_FALLBACK_MODEL=gemma4
LLM_FALLBACK_PATH=/v2/chat/completions   # same host as LLM_BASE_URL; gemma4 is served on /v2
LLM_FIRST_TOKEN_TIMEOUT_MS=1500
# No first token after this many ms: send the request again, use the faster one (0 = off).
LLM_HEDGE_MS=600
LLM_MAX_TOKENS_LIVE=200
EXTRACT_LLM_MODEL=sarvam-105b
# After each call, score it, list the agent's mistakes and suggest lessons for its train.md.
REVIEW_CALLS=true
# After the call, re-transcribe each caller turn with REST saaras:v4 (more
# accurate than live streaming) for the saved transcript and lead extraction.
# non_english (default): only calls not entirely in English; all; off.
RETRANSCRIBE_CALLER_TURNS=non_english

# --- Pipeline and guardrails -------------------------------------------------
DEFAULT_LANGUAGE=auto
# Pause that ends the caller's turn. 450 ms feels human: fewer cut-ins when the
# caller pauses mid-sentence and slightly cleaner transcripts, for ~150 ms more wait.
VAD_SILENCE_MS=450
# Audio sent ahead to Plivo; more smooths a choppy voice on a jittery network.
PLAYOUT_LEAD_MS=400
VAD_THRESHOLD=0.5
# Speech needed before the agent stops talking; "yeah"/"okay"/"haan" never interrupt.
BARGE_IN_MIN_MS=500
# Only clear, firm speech counts towards interrupting the agent (VAD_THRESHOLD is for turn taking).
BARGE_IN_VAD_THRESHOLD=0.7
# Clear caller speech that interrupts the agent; "wait" / "no" interrupt after BARGE_IN_MIN_MS.
BARGE_IN_TALK_MS=2000
EAGER_LLM=false
SILENCE_REPROMPT_SECS=5
# Extra wait when the caller says only "yes" / "so" / "hmm" (they are often about to say more).
ACK_WAIT_MS=2000
# If the reply hasn't started this long after the caller stops talking, a cached "one sec" plays (0 = off).
LATE_REPLY_MS=2000
DEFAULT_MAX_DURATION_SECS=300
MAX_SPOKEN_CHARS_PER_TURN=220
MAX_SENTENCES_PER_TURN=3          # hard cap; the prompt asks for 2, so a trailing question survives. 1-2 word acknowledgements don't count; 0 = off
MAX_TTS_CHARS_PER_CALL=4000
TELEPHONY_BILLING_PULSE_SECS=30    # Plivo billing block; 0 = not billing-aware
PULSE_WRAP_UP_SECS=5               # seconds kept for the goodbye before a block ends

# --- Call hours and limits ---------------------------------------------------
CALL_HOURS_ENFORCED=true
CALL_HOURS_START=9
CALL_HOURS_END=21
CALL_HOURS_TZ=Asia/Kolkata
CALLS_RATE_LIMIT_PER_MIN=30
SHUTDOWN_GRACE_SECS=120

# --- Models and threads -------------------------------------------------------
# VAD_THREADS=4                    # Silero VAD worker threads (default: min(cores, 4))
# EMBED_THREADS=2                  # bge-m3 ONNX intra-op threads

# --- Paths (defaults work for `cargo run` from the repo root) ----------------
# PROMPTS_DIR=prompts
# CONFIG_DIR=config
# MODELS_DIR=models

# --- Dashboard (voice-frontend) ----------------------------------------------
# Voice backend URL, server-side only; never exposed to the browser.
# The dashboard calls it with API_KEY above (or VOICE_API_KEY if set).
VOICE_API_URL=http://127.0.0.1:8080
# Dashboard sign-in. Required in production; without it, dev is open.
DASHBOARD_PASSWORD=
# Signs session cookies (any long random string; defaults to one derived from the password).
SESSION_SECRET=
# Set to 1 only when serving production over plain http (e.g. a LAN box).
INSECURE_COOKIES=
